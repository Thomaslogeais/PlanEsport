// =============================================================================
// PlanEsport — Prisma Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH — NextAuth.js v5 (tables requises par @auth/prisma-adapter)
// =============================================================================
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  followings    UserFollowing[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// USER FOLLOWING — Équipes / compétitions / tournois suivis
// =============================================================================
model UserFollowing {
  id         String   @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  entityType String   // "team" | "competition" | "tournament" | "game"
  entityId   String
  entityName String
  entitySlug String
  gameSlug   String?

  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@map("user_followings")
}

// =============================================================================
// GAME
// =============================================================================
model Game {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  imageUrl     String?

  competitions Competition[]
  teams        Team[]
  matches      Match[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("games")
}

// =============================================================================
// COMPETITION
// =============================================================================
model Competition {
  id           String       @id @default(cuid())
  providerName String
  providerId   String
  name         String
  slug         String
  imageUrl     String?

  gameId       String
  game         Game         @relation(fields: [gameId], references: [id])

  tournaments  Tournament[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([providerName, providerId])
  @@unique([gameId, slug])
  @@map("competitions")
}

// =============================================================================
// TOURNAMENT
// =============================================================================
model Tournament {
  id           String    @id @default(cuid())
  providerName String
  providerId   String
  name         String
  slug         String
  imageUrl     String?

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  startDate    DateTime?
  endDate      DateTime?
  status       String
  rawJson      Json?

  matches      Match[]
  bracket      Bracket?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([providerName, providerId])
  @@unique([competitionId, slug])
  @@map("tournaments")
}

// =============================================================================
// BRACKET
// =============================================================================
model Bracket {
  id           String     @id @default(cuid())
  providerName String
  providerId   String

  tournamentId String     @unique
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  rawJson      Json

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([providerName, providerId])
  @@map("brackets")
}

// =============================================================================
// TEAM
// =============================================================================
model Team {
  id           String      @id @default(cuid())
  providerName String
  providerId   String
  name         String
  slug         String
  imageUrl     String?

  gameId       String
  game         Game        @relation(fields: [gameId], references: [id])

  matchTeams   MatchTeam[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([providerName, providerId])
  @@unique([gameId, slug])
  @@map("teams")
}

// =============================================================================
// MATCH
// =============================================================================
model Match {
  id           String      @id @default(cuid())
  providerName String
  providerId   String
  name         String?
  scheduledAt  DateTime?
  status       String

  gameId       String
  game         Game        @relation(fields: [gameId], references: [id])

  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id])

  results      Json?
  streams      Json?
  rawJson      Json?

  teams        MatchTeam[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([providerName, providerId])
  @@map("matches")
}

// =============================================================================
// MATCH_TEAM
// =============================================================================
model MatchTeam {
  id       String  @id @default(cuid())

  matchId  String
  match    Match   @relation(fields: [matchId], references: [id])

  teamId   String
  team     Team    @relation(fields: [teamId], references: [id])

  isWinner Boolean @default(false)
  score    Int?

  @@unique([matchId, teamId])
  @@map("match_teams")
}

// =============================================================================
// SYNC_LOG
// =============================================================================
model SyncLog {
  id           String    @id @default(cuid())
  providerName String
  syncType     String
  status       String
  startedAt    DateTime
  endedAt      DateTime?
  message      String?
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  errorCount   Int       @default(0)

  createdAt    DateTime  @default(now())

  @@map("sync_logs")
}
