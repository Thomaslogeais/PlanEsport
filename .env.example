# =============================================================================
# MatchPulse — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/matchpulse"

# -----------------------------------------------------------------------------
# PandaScore API
# Obtenir un token sur : https://pandascore.co/
# -----------------------------------------------------------------------------
PANDASCORE_API_TOKEN="your_pandascore_token_here"
PANDASCORE_BASE_URL="https://api.pandascore.co"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"  # development | production

# -----------------------------------------------------------------------------
# Synchronisation manuelle
# Utilisé par : POST /api/sync/pandascore
# Méthodes d'auth acceptées :
#   - Header : x-sync-secret: <SYNC_SECRET>
#   - Query  : ?secret=<SYNC_SECRET>  (dev uniquement)
# -----------------------------------------------------------------------------
SYNC_SECRET="your_sync_secret_here"

# -----------------------------------------------------------------------------
# Cron automatique
# Utilisé par : GET /api/cron/sync (Vercel Cron)
# Méthode d'auth Vercel : Authorization: Bearer <CRON_SECRET>
# Également accepté en dev : x-sync-secret ou ?secret
# Générer un secret sécurisé : openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET="your_cron_secret_here"

# -----------------------------------------------------------------------------
# Authentification (à remplir lors de l'étape auth)
# -----------------------------------------------------------------------------
# NEXTAUTH_SECRET="your_nextauth_secret_here"
# NEXTAUTH_URL="http://localhost:3000"
